SECRET_KEY=change-me-to-a-random-string
ACME_EMAIL=your-email@example.com
CORS_ORIGINS=https://eenkaartjeleggen.nl

# Per-card wall-clock budget (seconds) for the search-based AI opponents
# (Opus, Mythos). Higher = stronger but slower. Neural is unaffected (it is not
# search-bound). Lower this on a small VPS. Default 1.0.
AI_CARD_BUDGET=1.0

# Optional: serve a different neural card-play checkpoint than models/neural_best.pt
# (e.g. a freshly trained roem-aware net) without replacing the tracked file.
# NEURAL_MODEL_PATH=models/neural_mythos_v2_rl.pt
# Net-rollout search for the public "neural" opponent's early tricks (see
# neural/pimc.py): the net proposes, rollouts with the same net over sampled
# deals judge.  Runs on CUDA when available, otherwise on the CPU (about
# 0.5-1 s per decision at 32 deals).  Off by default.
# NEURAL_SEARCH=1
# NEURAL_PIMC_DEALS=32        # sampled deals per decision (64 on a GPU)
# NEURAL_PIMC_MARGIN=8        # only override the net when the search is this many points better
# NEURAL_PIMC_THREADS=2       # CPU threads for the search (per process)
